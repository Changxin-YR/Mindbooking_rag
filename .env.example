# Compose release profile: staging + named sandbox providers. Use development for local memory-only tests.
APP_ENV=staging
COMPOSE_PROJECT_NAME=novel-platform
BOOKS_PUBLIC_HOST=localhost
BOOKS_API_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:8080,http://127.0.0.1:8080
MYSQL_HOST=localhost
MYSQL_PORT=127.0.0.1:13306
MYSQL_DATABASE=novel_platform
MYSQL_USER=novel
MYSQL_PASSWORD=novel_dev_only
MYSQL_ROOT_PASSWORD=novel_root_dev_only
REDIS_PORT=127.0.0.1:6379
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://novel:novel_dev_only@localhost:5672/
RABBITMQ_DEFAULT_USER=novel
RABBITMQ_DEFAULT_PASS=novel_dev_only
RABBITMQ_PORT=127.0.0.1:5672
RABBITMQ_MANAGEMENT_PORT=127.0.0.1:15672
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_PORT=127.0.0.1:9200
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_PORT=127.0.0.1:8123
CLICKHOUSE_NATIVE_PORT=127.0.0.1:19000
CLICKHOUSE_DB=novel_platform
CLICKHOUSE_USER=novel
CLICKHOUSE_PASSWORD=clickhouse_dev_only
S3_ENDPOINT=http://localhost:9000
S3_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_only
NGINX_HTTP_PORT=127.0.0.1:8080
HMAC_SECRET=development-only-change-me
PII_FINGERPRINT_SECRET=development-only-change-me
SESSION_SECRET=development-only-session-secret
REAL_NAME_ENCRYPTION_KEY=development-only-real-name-encryption-key
SESSION_TTL_SECONDS=86400
PAYMENT_CALLBACK_SECRET=development-only-payment-callback-secret
PAYMENT_CALLBACK_MAX_SKEW_SECONDS=300
# Sandbox channel options: SANDBOX_ALIPAY, SANDBOX_WECHAT; payout: SANDBOX_BANK.
PAYMENT_PROVIDER=SANDBOX_ALIPAY
PAYOUT_PROVIDER=SANDBOX_BANK
# Non-financial third-party boundaries (staging-only, deterministic, no network).
SMS_PROVIDER=SANDBOX_SMS
OAUTH_WECHAT_PROVIDER=SANDBOX_OAUTH_WECHAT
OAUTH_QQ_PROVIDER=SANDBOX_OAUTH_QQ
REALNAME_PROVIDER=SANDBOX_REALNAME
MODERATION_PROVIDER=SANDBOX_MODERATION
STORAGE_PROVIDER=SANDBOX_STORAGE
NOTIFICATION_PROVIDER=SANDBOX_NOTIFICATION
# MySQL is the source of truth for all business facts. Tests may explicitly use memory.
PERSISTENCE_MODE=sql
# Staging-only bootstrap Staff; override both values for shared environments.
STAFF_BOOTSTRAP_EMPLOYEE_CODE=qa-admin
STAFF_BOOTSTRAP_PASSWORD=QaAdmin#123456
OUTBOX_WORKER_ID=backend-outbox
OUTBOX_POLL_INTERVAL_SECONDS=1
# DeepSeek Harness native Web integration (Admin Console only). Leave API key empty to fail closed.
AGENT_BACKEND_URL=http://backend:80
AGENT_DSH_HOME=.dsh-novel-platform
DEEPSEEK_HARNESS_SDK_PATH=
DEEPSEEK_HARNESS_PROFILE=web
DEEPSEEK_HARNESS_RUNTIME_MODE=web
DEEPSEEK_HARNESS_REPO=../../deepseek-harness-master
DEEPSEEK_HARNESS_WEB_COMMAND=
DEEPSEEK_HARNESS_DSH_BIN=
DEEPSEEK_HARNESS_WEB_START_TIMEOUT_SECONDS=120
DEEPSEEK_HARNESS_WEB_BRIDGE_URL=http://harness:8090
DEEPSEEK_HARNESS_WEB_BRIDGE_SECRET=development-only-harness-bridge-secret
HARNESS_WEB_PORT_RANGE=127.0.0.1:3080-3180
HARNESS_IDLE_TIMEOUT_SECONDS=300
DEEPSEEK_PROVIDER=deepseek-official
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=120
